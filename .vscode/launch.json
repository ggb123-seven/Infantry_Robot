{
    "version": "0.2.0",
    "configurations": [

        {
            "type": "jlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: Launch JLink GDB Server (local)",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "serverExe": "${env:LOCALAPPDATA}\\stm32cube\\bundles\\jlink-gdbserver\\9.24.0+st.1\\bin\\JLinkGDBServerCL.exe",
            "serverDevice": "STM32F407IG",
            "serverInterface": "SWD",
            "serverSpeed": "4000",
            "serverRtos": {
                "enabled": false
            },
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/Debug/Infantry_Robot.elf",
                    "symbolFileName": "${workspaceFolder}/build/Debug/Infantry_Robot.elf"
                }
            ]
        }
    ]
}
